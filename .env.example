# ==============================================================================
# DATABASE
# Dev: SQLite file path. Prod: Cloudflare D1 connection string or PostgreSQL URL
# ==============================================================================
DATABASE_URL="file:./prisma/dev.db"

# ==============================================================================
# AUTH: Session
# Generate a strong secret: openssl rand -base64 32
# ==============================================================================
SESSION_SECRET="your-strong-random-secret-here"

# ==============================================================================
# AUTH: OTP (SMS via Fast2SMS or Twilio)
# ==============================================================================
FAST2SMS_API_KEY="your-fast2sms-api-key"
# OR if using Twilio:
# TWILIO_ACCOUNT_SID="your-twilio-account-sid"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# ==============================================================================
# AUTH: OTP (Email via Resend)
# ==============================================================================
RESEND_API_KEY="your-resend-api-key"
OTP_FROM_EMAIL="noreply@sweetspotbakery.in"

# ==============================================================================
# PAYMENT: Razorpay
# Get these from https://dashboard.razorpay.com/app/keys
# ==============================================================================
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
# Expose ONLY the key_id to the client (never the secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# ==============================================================================
# APP
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
